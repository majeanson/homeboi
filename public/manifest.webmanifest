{
  "name": "Babillard — le babillard familial",
  "short_name": "Babillard",
  "description": "Le babillard familial sur la tablette de cuisine : le souper, la liste d’épicerie, les routines des enfants et les corvées — d’un coup d’œil. Calme par choix : pas de points, pas de notifications.",
  "lang": "fr",
  "categories": ["lifestyle", "productivity"],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*"] }]
    }
  },
  "background_color": "#FBF3E4",
  "theme_color": "#FBF3E4",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Ajouter à la liste",
      "short_name": "Liste",
      "url": "/liste",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Ce soir — Souper",
      "short_name": "Souper",
      "url": "/board",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Mes routines",
      "short_name": "Routines",
      "url": "/maison",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
