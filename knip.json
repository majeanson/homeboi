{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs",
    "functions/api/**/*.ts",
    "functions/test/*.ts",
    "{functions,worker}/**/*.d1.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "worker/**/*.ts",
    "functions/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "cloudflare"
  ]
}
