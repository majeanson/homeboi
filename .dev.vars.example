# Shape of .dev.vars (gitignored — never commit the real file).
# Copy to .dev.vars and fill in. For local dev `wrangler dev` loads these.

# Marks this as local dev. REQUIRED for `wrangler dev` to work: the custom_domain
# route makes the Worker see the prod host even locally, so without this the
# force-HTTPS redirect in worker/index.ts bounces /api to a TLS-less https and dev
# hangs. Unset in prod (there the redirect must fire). Keep it exactly this value.
ENVIRONMENT=development

# HMAC key for the operator session cookie + device tokens. MUST be >= 32 chars.
# Generate one: `openssl rand -hex 32`
SESSION_SECRET=replace-with-at-least-32-random-characters-xx

# OPTIONAL shared login password. When set, /api/auth/login requires it (on top
# of the email). Leave unset for open login on a trusted LAN / local dev; SET it
# for any public deployment so a stranger can't sign in as you (email-only login
# has no other gate). Not a per-user password store — one shared household secret.
# LOGIN_PASSWORD=choose-a-strong-passphrase

# OPTIONAL Mistral API key — enables the high-accuracy CLOUD recipe-photo reader
# (Réglages ▸ Affichage ▸ « Lecture des photos de recette » → Haute précision).
# Free "Experiment" tier (no card) at https://console.mistral.ai. Unset = on-device
# Tesseract OCR only (free, private). The image is sent to Mistral when enabled.
# MISTRAL_API_KEY=your-mistral-api-key
