# Shape of .dev.vars (gitignored — never commit the real file).
# Copy to .dev.vars and fill in. For local dev `wrangler dev` loads these.

# Marks this as local dev. REQUIRED for `wrangler dev` to work: the custom_domain
# route makes the Worker see the prod host even locally, so without this the
# force-HTTPS redirect in worker/index.ts bounces /api to a TLS-less https and dev
# hangs. Unset in prod (there the redirect must fire). Keep it exactly this value.
ENVIRONMENT=development

# HMAC key for the operator session cookie + device tokens. MUST be >= 32 chars.
# Generate one: `openssl rand -hex 32`
SESSION_SECRET=replace-with-at-least-32-random-characters-xx

# OPTIONAL shared secret from before per-account passwords. It is the password of a
# LEGACY account (no password_hash) at login, and — while SIGNUP_OPEN (wrangler.toml)
# is not "1" — the signup invite code. Leave unset on a trusted LAN / local dev; SET it
# on any public deployment that has legacy accounts, even after signup opens.
# LOGIN_PASSWORD=choose-a-strong-passphrase

# OPTIONAL Mistral API key — enables the high-accuracy CLOUD recipe-photo reader
# (Réglages ▸ Affichage ▸ « Lecture des photos de recette » → Haute précision).
# Free "Experiment" tier (no card) at https://console.mistral.ai. Unset = on-device
# Tesseract OCR only (free, private). The image is sent to Mistral when enabled.
# MISTRAL_API_KEY=your-mistral-api-key

# OPTIONAL deploy-callback secret for POST /api/remarks/shipped — how CI tells the live
# app that a deploy shipped the fix for a remark (« Les remarques », 0136). MUST be ≥32
# characters, and MUST match the repo's DEPLOY_NOTIFY_SECRET Actions secret.
#
# UNSET CLOSES THE DOOR (503), unlike LOGIN_PASSWORD above — an unset gate on an
# unauthenticated write endpoint is a hole, not a convenience. Leave it unset locally
# unless you are testing the callback; the rest of the feature works without it.
# Production: `wrangler secret put DEPLOY_NOTIFY_SECRET`. /api/health reports `deployHook`.
# DEPLOY_NOTIFY_SECRET=at-least-thirty-two-characters-long
