{
  "name": "babillard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Calm household planner — wall-tablet board + kitchen + kid view. CF Worker + static assets + D1 + Workers AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "precf:dev": "npm run db:sync:local",
    "cf:dev": "wrangler dev",
    "typecheck": "tsc -b --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:d1": "vitest run -c vitest.d1.config.ts",
    "e2e": "playwright test",
    "e2e:sw": "playwright test -c e2e/sw.config.ts",
    "e2e:matrix": "playwright test -c e2e/sm.config.ts",
    "e2e:flipp": "playwright test -c e2e/flipp.config.ts",
    "e2e:stranger": "playwright test -c e2e/stranger.config.ts",
    "e2e:report": "playwright show-report e2e/report",
    "promo:capture": "playwright test -c promo/capture/promo.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply babillard --local && npm run db:sync:local",
    "db:sync:local": "node --experimental-sqlite scripts/sync-local-d1.mjs",
    "db:migrate:prod": "wrangler d1 migrations apply babillard --remote",
    "e2e:ci": "playwright test --workers=1 --retries=0 --forbid-only"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "heic2any": "^0.0.4",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.1.11",
    "@cloudflare/workers-types": "^4.20260606.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "knip": "^6.35.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.131.1"
  }
}
