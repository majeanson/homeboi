{
  "name": "babillard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Calm household planner — wall-tablet board + kitchen + kid view. CF Worker + static assets + D1 + Workers AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "precf:dev": "npm run db:sync:local",
    "cf:dev": "wrangler dev",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src functions worker e2e scripts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "perf:door": "node scripts/coldstart.mjs",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:d1": "vitest run -c vitest.d1.config.ts",
    "e2e": "playwright test",
    "e2e:sw": "playwright test -c e2e/sw.config.ts",
    "e2e:matrix": "playwright test -c e2e/sm.config.ts",
    "e2e:flipp": "playwright test -c e2e/flipp.config.ts",
    "e2e:recipes": "playwright test -c e2e/recipe.config.ts",
    "e2e:stranger": "playwright test -c e2e/stranger.config.ts",
    "e2e:report": "playwright show-report e2e/report",
    "promo:capture": "playwright test -c promo/capture/promo.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply babillard --local && npm run db:sync:local",
    "db:sync:local": "node --experimental-sqlite scripts/sync-local-d1.mjs",
    "db:migrate:prod": "wrangler d1 migrations apply babillard --remote",
    "e2e:ci": "playwright test --workers=1 --retries=0 --forbid-only"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "heic2any": "^0.0.4",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.1",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.32",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.143.1"
  }
}
